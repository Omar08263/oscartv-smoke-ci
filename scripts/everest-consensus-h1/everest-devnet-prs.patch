diff --git a/etc/docker/everest-contracts/DevnetGenesis.s.sol b/etc/docker/everest-contracts/DevnetGenesis.s.sol
new file mode 100644
index 000000000..a5e7a28a4
--- /dev/null
+++ b/etc/docker/everest-contracts/DevnetGenesis.s.sol
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.15;
+
+import { SystemDeploy } from "scripts/deploy/SystemDeploy.s.sol";
+import { L2Genesis } from "scripts/L2Genesis.s.sol";
+import { Fork } from "scripts/libraries/Config.sol";
+import { Types } from "scripts/libraries/Types.sol";
+import { Hash, Proposal } from "src/libraries/bridge/Types.sol";
+
+/// @dev Calls the pinned release's deployer in the offline genesis VM. The default
+/// execution devnet has no proof producers and does not register a dispute game.
+contract DevnetL1 is SystemDeploy {
+    function build(
+        uint256 l1ChainId, uint256 l2ChainId, address owner, address batcher, address sequencer,
+        uint64 gasLimit, bytes32 salt, uint32 baseFeeScalar, uint32 blobFeeScalar
+    ) external returns (string memory) {
+        vm.chainId(l1ChainId);
+        DeployInput memory input;
+        input.implementationsInput.withdrawalDelaySeconds = 302400;
+        input.implementationsInput.proofMaturityDelaySeconds = 604800;
+        input.implementationsInput.disputeGameFinalityDelaySeconds = 302400;
+        input.implementationsInput.guardian = owner;
+        input.opChainInput.roles = Types.Roles(owner, owner, batcher, sequencer, address(0));
+        input.opChainInput.basefeeScalar = baseFeeScalar;
+        input.opChainInput.blobBasefeeScalar = blobFeeScalar;
+        input.opChainInput.l2ChainId = l2ChainId;
+        input.opChainInput.startingAnchorRoot = Proposal(Hash.wrap(bytes32(uint256(1))), 0);
+        input.opChainInput.saltMixer = vm.toString(salt);
+        input.opChainInput.gasLimit = gasLimit;
+        input.opChainInput.initialMinimumProtocolVersion = 1 << 32;
+        DeployOutput memory out = deploy(input);
+        return addresses(out);
+    }
+
+    /// @dev Names match op-deployer's l1-addresses.json. OP-only contracts stay absent.
+    function addresses(DeployOutput memory out) internal returns (string memory) {
+        Types.DeployOutput memory c = out.opChain;
+        Types.Implementations memory i = out.impls;
+        string memory k = "l1";
+        vm.serializeAddress(k, "OpChainProxyAdminImpl", address(c.opChainProxyAdmin));
+        vm.serializeAddress(k, "AddressManagerImpl", address(c.addressManager));
+        vm.serializeAddress(k, "L1ERC721BridgeProxy", address(c.l1ERC721BridgeProxy));
+        vm.serializeAddress(k, "SystemConfigProxy", address(c.systemConfigProxy));
+        vm.serializeAddress(k, "OptimismMintableERC20FactoryProxy", address(c.optimismMintableERC20FactoryProxy));
+        vm.serializeAddress(k, "L1StandardBridgeProxy", address(c.l1StandardBridgeProxy));
+        vm.serializeAddress(k, "L1CrossDomainMessengerProxy", address(c.l1CrossDomainMessengerProxy));
+        vm.serializeAddress(k, "OptimismPortalProxy", address(c.optimismPortalProxy));
+        vm.serializeAddress(k, "DisputeGameFactoryProxy", address(c.disputeGameFactoryProxy));
+        vm.serializeAddress(k, "AnchorStateRegistryProxy", address(c.anchorStateRegistryProxy));
+        vm.serializeAddress(k, "DelayedWethPermissionlessGameProxy", address(c.delayedWETHProxy));
+        vm.serializeAddress(k, "ProtocolVersionsProxy", address(c.protocolVersionsProxy));
+        vm.serializeAddress(k, "L1ERC721BridgeImpl", i.l1ERC721BridgeImpl);
+        vm.serializeAddress(k, "OptimismPortalImpl", i.optimismPortalImpl);
+        vm.serializeAddress(k, "SystemConfigImpl", i.systemConfigImpl);
+        vm.serializeAddress(k, "OptimismMintableERC20FactoryImpl", i.optimismMintableERC20FactoryImpl);
+        vm.serializeAddress(k, "L1CrossDomainMessengerImpl", i.l1CrossDomainMessengerImpl);
+        vm.serializeAddress(k, "L1StandardBridgeImpl", i.l1StandardBridgeImpl);
+        vm.serializeAddress(k, "DisputeGameFactoryImpl", i.disputeGameFactoryImpl);
+        vm.serializeAddress(k, "AnchorStateRegistryImpl", i.anchorStateRegistryImpl);
+        vm.serializeAddress(k, "DelayedWethImpl", i.delayedWETHImpl);
+        return vm.serializeAddress(k, "ProtocolVersionsImpl", i.protocolVersionsImpl);
+    }
+}
+
+contract DevnetL2 is L2Genesis {
+    function build(
+        uint256 l1ChainId, uint256 l2ChainId, address owner, address payable messenger,
+        address payable bridge, address payable erc721Bridge, uint256 minWithdrawal, bool fundAccounts
+    ) external {
+        Input memory input;
+        input.l1ChainID = l1ChainId;
+        input.l2ChainID = l2ChainId;
+        input.l1CrossDomainMessengerProxy = messenger;
+        input.l1StandardBridgeProxy = bridge;
+        input.l1ERC721BridgeProxy = erc721Bridge;
+        input.opChainProxyAdminOwner = owner;
+        input.sequencerFeeVaultRecipient = owner;
+        input.baseFeeVaultRecipient = owner;
+        input.l1FeeVaultRecipient = owner;
+        input.operatorFeeVaultRecipient = owner;
+        input.sequencerFeeVaultMinimumWithdrawalAmount = minWithdrawal;
+        input.baseFeeVaultMinimumWithdrawalAmount = minWithdrawal;
+        input.l1FeeVaultMinimumWithdrawalAmount = minWithdrawal;
+        input.operatorFeeVaultMinimumWithdrawalAmount = minWithdrawal;
+        // The devnet pays fees on L2 (LOCAL), not via withdrawals to L1.
+        input.sequencerFeeVaultWithdrawalNetwork = 1;
+        input.baseFeeVaultWithdrawalNetwork = 1;
+        input.l1FeeVaultWithdrawalNetwork = 1;
+        input.operatorFeeVaultWithdrawalNetwork = 1;
+        input.fork = uint256(Fork.JOVIAN);
+        input.fundDevAccounts = fundAccounts;
+        run(input);
+    }
+}
diff --git a/etc/docker/everest-contracts/deploy.go b/etc/docker/everest-contracts/deploy.go
new file mode 100644
index 000000000..78d273349
--- /dev/null
+++ b/etc/docker/everest-contracts/deploy.go
@@ -0,0 +1,101 @@
+// Compiled into the Everest setup image in place of op-deployer's OP-specific
+// deployment phase. Genesis headers, rollup config and beacon setup are shared.
+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"math/big"
+	"os"
+
+	"github.com/ethereum-optimism/optimism/op-chain-ops/addresses"
+	"github.com/ethereum-optimism/optimism/op-chain-ops/foundry"
+	"github.com/ethereum-optimism/optimism/op-chain-ops/script"
+	"github.com/ethereum-optimism/optimism/op-deployer/pkg/deployer/broadcaster"
+	"github.com/ethereum-optimism/optimism/op-deployer/pkg/deployer/opcm"
+	"github.com/ethereum-optimism/optimism/op-deployer/pkg/deployer/pipeline"
+	"github.com/ethereum-optimism/optimism/op-deployer/pkg/deployer/standard"
+	"github.com/ethereum-optimism/optimism/op-deployer/pkg/deployer/state"
+	scriptenv "github.com/ethereum-optimism/optimism/op-deployer/pkg/env"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/log"
+)
+
+type devnetL1 struct {
+	Build func(*big.Int, *big.Int, common.Address, common.Address, common.Address, uint64, [32]byte, uint32, uint32) (string, error)
+}
+
+type devnetL2 struct {
+	Build func(*big.Int, *big.Int, common.Address, common.Address, common.Address, common.Address, *big.Int, bool) error
+}
+
+func deploy(intent *state.Intent, st *state.State, logger log.Logger, _ string) error {
+	if err := intent.Check(); err != nil {
+		return err
+	}
+	if len(intent.Chains) != 1 {
+		return fmt.Errorf("Everest requires a single-chain intent")
+	}
+	chain := intent.Chains[0]
+	artifactDir := os.Getenv("BASE_DEVNET_ARTIFACTS")
+	if artifactDir == "" {
+		return fmt.Errorf("missing pinned Everest contract artifacts")
+	}
+	fs := os.DirFS(artifactDir).(foundry.StatDirFs)
+	deployer := common.Address{0x01}
+	newHost := func() (*script.Host, error) {
+		return scriptenv.DefaultScriptHost(broadcaster.NoopBroadcaster(), logger, deployer, fs)
+	}
+	l1, err := newHost()
+	if err != nil {
+		return err
+	}
+	if err := pipeline.InitGenesisStrategy(&pipeline.Env{Logger: logger}, intent, st); err != nil {
+		return err
+	}
+	l1Script, cleanup, err := script.WithScript[devnetL1](l1, "DevnetGenesis.s.sol", "DevnetL1")
+	if err != nil {
+		return err
+	}
+	encoded, err := l1Script.Build(intent.L1ChainIDBig(), chain.ID.Big(), chain.Roles.L1ProxyAdminOwner, chain.Roles.Batcher, chain.Roles.UnsafeBlockSigner, chain.GasLimit, st.Create2Salt, standard.BasefeeScalar, standard.BlobBaseFeeScalar)
+	cleanup()
+	if err != nil {
+		return fmt.Errorf("deploy Base L1 contracts: %w", err)
+	}
+	var contracts addresses.L1Contracts
+	if err := json.Unmarshal([]byte(encoded), &contracts); err != nil {
+		return fmt.Errorf("decode Base L1 deployment: %w", err)
+	}
+	if err := opcm.InsertPreinstalls(l1); err != nil {
+		return err
+	}
+	l1.Wipe(deployer)
+	l1Dump, err := l1.StateDump()
+	if err != nil {
+		return err
+	}
+	l2, err := newHost()
+	if err != nil {
+		return err
+	}
+	l2Script, cleanup, err := script.WithScript[devnetL2](l2, "DevnetGenesis.s.sol", "DevnetL2")
+	if err != nil {
+		return err
+	}
+	err = l2Script.Build(intent.L1ChainIDBig(), chain.ID.Big(), chain.Roles.L2ProxyAdminOwner, contracts.L1CrossDomainMessengerProxy, contracts.L1StandardBridgeProxy, contracts.L1Erc721BridgeProxy, standard.VaultMinWithdrawalAmount.ToInt(), intent.FundDevAccounts)
+	cleanup()
+	if err != nil {
+		return fmt.Errorf("initialize Base L2 predeploys: %w", err)
+	}
+	l2.Wipe(deployer)
+	l2Dump, err := l2.StateDump()
+	if err != nil {
+		return err
+	}
+	st.SuperchainDeployment = &contracts.SuperchainContracts
+	st.ImplementationsDeployment = &contracts.ImplementationsContracts
+	st.Chains = []*state.ChainState{{ID: chain.ID, OpChainContracts: contracts.OpChainContracts, Allocs: &state.GzipData[foundry.ForgeAllocs]{Data: l2Dump}}}
+	st.L1StateDump = &state.GzipData[foundry.ForgeAllocs]{Data: l1Dump}
+	st.AppliedIntent = intent
+	return nil
+}
diff --git a/etc/docker/everest-contracts/deploy_test.go b/etc/docker/everest-contracts/deploy_test.go
new file mode 100644
index 000000000..a84c1f585
--- /dev/null
+++ b/etc/docker/everest-contracts/deploy_test.go
@@ -0,0 +1,54 @@
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/ethereum-optimism/optimism/op-chain-ops/foundry"
+	"github.com/ethereum-optimism/optimism/op-deployer/pkg/deployer/state"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/log"
+	"github.com/stretchr/testify/require"
+)
+
+func TestEverestContractGenesis(t *testing.T) {
+	for i, role := range []string{"DEPLOYER_ADDR", "SEQUENCER_ADDR", "BATCHER_ADDR", "PROPOSER_ADDR", "CHALLENGER_ADDR"} {
+		t.Setenv(role, fmt.Sprintf("0x%040x", 100+i))
+	}
+	intent, err := baseIntent("1337", 84538453)
+	require.NoError(t, err)
+	st := &state.State{Version: 1}
+	require.NoError(t, deploy(intent, st, log.New(), ""))
+	implSlot := common.HexToHash("0x360894a13ba1a3210667c828492db98dca3e2076cc3735a920a3ca505d382bbc")
+	checkProxy := func(name string, alloc *foundry.ForgeAllocs, proxy, impl common.Address) {
+		t.Helper()
+		require.NotEmpty(t, alloc.Accounts[proxy].Code, name)
+		require.Equal(t, common.BytesToHash(impl.Bytes()), alloc.Accounts[proxy].Storage[implSlot], name)
+		artifact, err := foundry.ReadArtifact(filepath.Join(os.Getenv("BASE_DEVNET_ARTIFACTS"), name+".sol", name+".json"))
+		require.NoError(t, err)
+		got := alloc.Accounts[impl].Code
+		want := bytes.Clone(artifact.DeployedBytecode.Object)
+		require.NotEmpty(t, want, name)
+		require.Len(t, got, len(want), name)
+		// Constructors fill only these compiler-declared offsets at deployment.
+		var refs map[string][]struct{ Start, Length int }
+		if raw := artifact.DeployedBytecode.ImmutableReferences; len(raw) > 0 {
+			require.NoError(t, json.Unmarshal(raw, &refs))
+		}
+		for _, offsets := range refs {
+			for _, r := range offsets {
+				end := r.Start + r.Length
+				copy(want[r.Start:end], got[r.Start:end])
+			}
+		}
+		require.True(t, bytes.Equal(want, got), "%s implementation differs from the release artifact", name)
+	}
+	chain := st.Chains[0]
+	checkProxy("SystemConfig", st.L1StateDump.Data, chain.SystemConfigProxy, st.ImplementationsDeployment.SystemConfigImpl)
+	checkProxy("L2StandardBridge", chain.Allocs.Data, common.HexToAddress("0x4200000000000000000000000000000000000010"), common.HexToAddress("0xc0d3c0d3c0d3c0d3c0d3c0d3c0d3c0d3c0d30010"))
+	checkProxy("BaseTime", chain.Allocs.Data, common.HexToAddress("0x4200000000000000000000000000000000000030"), common.HexToAddress("0xc0d3c0d3c0d3c0d3c0d3c0d3c0d3c0d3c0d30030"))
+}
